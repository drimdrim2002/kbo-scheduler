# 이 파일을 .env 로 복사해 값을 넣는다(.env 는 커밋하지 않는다).
# 카카오 지도 JavaScript 키: https://developers.kakao.com → 내 애플리케이션 → 앱 키 → JavaScript 키
# 넣은 뒤 `bash scripts/ui-config.sh` 를 한 번 돌리면 ui/config.local.json 이 생기고, 편성 스튜디오가 이 키로 카카오 지도를 연다.
KAKAO_JS_KEY=
# 카카오 REST API 키(같은 앱의 「REST API 키」): 구장 사이 도로거리 자동 계산(카카오모빌리티 길찾기).
# 비밀 키라 화면(브라우저)에는 보내지 않고 편성 서버만 쓴다 → scripts/run-server.sh 로 열어야 동작한다.
KAKAO_REST_KEY=
