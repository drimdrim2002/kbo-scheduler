{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kbo-studio",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "scripts/run-server.sh",
        "--port",
        "8095",
        "--ui",
        "ui",
        "--max-seconds",
        "300",
        "--seeds",
        "4"
      ],
      "port": 8095
    },
    {
      "name": "kbo-server",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "JAVA_TOOL_OPTIONS=-XX:ActiveProcessorCount=4",
        "bash",
        "scripts/run-server.sh",
        "--port",
        "8080",
        "--ui",
        "ui",
        "--max-seconds",
        "300",
        "--seeds",
        "4"
      ],
      "port": 8080
    },
    {
      "name": "ui-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8091",
        "--directory",
        "ui"
      ],
      "port": 8091
    }
  ]
}
