<?xml version="1.0" encoding="UTF-8"?>
<solver xmlns="https://www.optaplanner.org/xsd/solver"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="https://www.optaplanner.org/xsd/solver https://www.optaplanner.org/xsd/solver/solver.xsd">
  <!--<environmentMode>FULL_ASSERT</environmentMode>--><!-- To slowly prove there are no bugs in this code -->
  <environmentMode>REPRODUCIBLE</environmentMode>
  <randomSeed>0</randomSeed>
  <moveThreadCount>4</moveThreadCount>
  <!-- To solve faster by saturating multiple CPU cores -->

  <!-- Domain model configuration -->
  <solutionClass>org.optaplanner.examples.baseball.domain.BaseballSolution</solutionClass>
  <entityClass>org.optaplanner.examples.baseball.domain.Match</entityClass>

  <!-- Score configuration -->
  <scoreDirectorFactory>
    <constraintProviderClass>org.optaplanner.examples.baseball.score.BaseballConstraintProvider</constraintProviderClass>
    <!--<easyScoreCalculatorClass>org.optaplanner.examples.cloudbalancing.optional.score.CloudBalancingMapBasedEasyScoreCalculator</easyScoreCalculatorClass>-->
    <!--<constraintProviderClass>org.optaplanner.examples.cloudbalancing.optional.score.CloudBalancingConstraintProvider</constraintProviderClass>-->
    <!--    <incrementalScoreCalculatorClass>org.optaplanner.examples.ba.optional.score.CloudBalancingIncrementalScoreCalculator</incrementalScoreCalculatorClass>-->
    <!--    <initializingScoreTrend>ONLY_DOWN</initializingScoreTrend>-->
  </scoreDirectorFactory>

  <!-- Optimization algorithms configuration -->
  <!-- Time limit (the server's 300-second maximum). The run normally ends earlier on the score-calculation count of the
       local search phase below, so the same seed always gives the same result however fast the machine is. A run that
       ends on this time limit is not reproducible. The web server and the bench tools replace both limits in code
       (BenchSupport.withWorkLimits). -->
  <termination>
    <secondsSpentLimit>300</secondsSpentLimit>
  </termination>

  <!-- Power tweaked optimization algorithms configuration -->
  <!--  <constructionHeuristic>-->
  <!--    <constructionHeuristicType>FIRST_FIT_DECREASING</constructionHeuristicType>-->
  <!--  </constructionHeuristic>-->
  <localSearch>

    <!-- Work done, not time: 1,650,000 score calculations = 300 seconds on the public server at 5,500 per second
         (BenchSupport.CALCS_PER_SECOND). The phase may also end after 6000 steps with no better score, but only once it
         has done 1,237,500 calculations (75%, BenchSupport.MIN_WORK_PERCENT). -->
    <termination>
      <scoreCalculationCountLimit>1650000</scoreCalculationCountLimit>
      <termination>
        <terminationCompositionStyle>AND</terminationCompositionStyle>
        <unimprovedStepCountLimit>6000</unimprovedStepCountLimit>
        <scoreCalculationCountLimit>1237500</scoreCalculationCountLimit>
      </termination>
    </termination>
    <unionMoveSelector>
      <!-- Full rounds only. Sub-pillars of 1..4 series break the five-game matching and are not scored. -->
      <pillarSwapMoveSelector>
        <subPillarType>NONE</subPillarType>
      </pillarSwapMoveSelector>
      <moveIteratorFactory>
        <moveIteratorFactoryClass>org.optaplanner.examples.baseball.solver.KempeChainMoveIteratorFactory</moveIteratorFactoryClass>
      </moveIteratorFactory>
      <moveIteratorFactory>
        <moveIteratorFactoryClass>org.optaplanner.examples.baseball.solver.RoundBlockMoveIteratorFactory</moveIteratorFactoryClass>
      </moveIteratorFactory>
    </unionMoveSelector>
    <acceptor>
      <!--      <lateAcceptanceSize>20000</lateAcceptanceSize>-->
      <lateAcceptanceSize>2000</lateAcceptanceSize>
    </acceptor>
    <forager>
      <acceptedCountLimit>40</acceptedCountLimit>
    </forager>
  </localSearch>

  <!-- Alternative power tweaked optimization algorithms configuration -->
  <!--<partitionedSearch>-->
  <!--<solutionPartitionerClass>org.optaplanner.examples.cloudbalancing.optional.partitioner.CloudBalancePartitioner</solutionPartitionerClass>-->
  <!--<solutionPartitionerCustomProperties>-->
  <!--<partCount>4</partCount>-->
  <!--<minimumProcessListSize>300</minimumProcessListSize>-->
  <!--</solutionPartitionerCustomProperties>-->
  <!--</partitionedSearch>-->
</solver>
