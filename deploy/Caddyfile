# /etc/caddy/Caddyfile — HTTPS 종단 + 리버스 프록시. Cloudflare 프록시(주황 구름)를 켜면 SSL 모드는 "Full (strict)".
# Caddy 가 Let's Encrypt 인증서를 HTTP-01 로 받으므로 80 포트가 열려 있어야 한다.

# 방문자 주소(IP당 동시 1작업 제한에 쓴다). Cloudflare 를 거쳐 오면 바로 앞 주소는 Cloudflare 서버라서,
# Cloudflare 대역에서 온 요청일 때만 CF-Connecting-IP 를 방문자 주소({client_ip})로 받는다. 대역 밖에서 바로 온 요청은
# 헤더를 꾸며도 실제 접속 주소가 쓰인다. Caddy 2.7 이상 필요(client_ip_headers).
# 대역 출처: https://www.cloudflare.com/ips-v4 · ips-v6 (2026-10-21 기준). 바뀌면 이 목록만 고치고 systemctl reload caddy.
{
    servers {
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        client_ip_headers CF-Connecting-IP
    }
}

schedulelab.kr, www.schedulelab.kr {
    encode zstd gzip
    # SSE(/api/v1/solve/{id}/events)는 버퍼링 없이 흘려보낸다
    reverse_proxy 127.0.0.1:8080 {
        flush_interval -1
        # 서버(BaseballWebServer.clientIp)는 루프백에서 온 요청의 X-Real-IP 만 믿는다
        header_up X-Real-IP {client_ip}
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
    # OG 이미지·정적 파일은 Cloudflare 가 캐시한다(서버는 Cache-Control 만 준다)
    log {
        output file /var/log/caddy/kbo-scheduler.log
    }
}
